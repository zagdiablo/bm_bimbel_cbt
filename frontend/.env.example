# URL Web App Google Apps Script (deployment "Anyone").
# Kosongkan untuk memakai mock backend lokal (localStorage) saat development.
VITE_GAS_API_URL=

# Nama aplikasi yang tampil di UI.
VITE_APP_NAME=CBT Sekolah

# Opsional: Google OAuth Client ID (Web). Jika kosong, tombol login Google tidak dirender.
VITE_GOOGLE_CLIENT_ID=

# auto = mock jika VITE_GAS_API_URL kosong, true = paksa mock, false = paksa GAS.
VITE_USE_MOCK=auto

# Persentase error acak pada mock backend (0-100). Default 0 agar demo stabil.
# Error deterministik tetap bisa diuji lewat tombol "Simulasi error" di dev toolbar.
VITE_MOCK_ERROR_RATE=0
